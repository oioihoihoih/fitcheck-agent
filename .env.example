# FitCheck local configuration example.
# Copy the keys you need into .env. Do not commit real secrets.

# Production agent LLM, OpenAI cloud Responses API.
OPENAI_API_KEY=
FITCHECK_LLM_MODEL=gpt-5.4-mini
FITCHECK_LLM_API=responses
FITCHECK_LLM_TIMEOUT=60
FITCHECK_LLM_MAX_RETRIES=1
FITCHECK_AGENT_MAX_TURNS=18

# Alternative local OpenAI-compatible LLM, such as Ollama, LM Studio, or vLLM.
# FITCHECK_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FITCHECK_LLM_API_KEY=ollama
# FITCHECK_LLM_MODEL=llama3.1
# FITCHECK_LLM_API=chat_completions

# Live search provider. Brave is the recommended hosted provider for new setup.
FITCHECK_SEARCH_PROVIDER=brave_search
BRAVE_SEARCH_API_KEY=
FITCHECK_SEARCH_TIMEOUT=12
FITCHECK_SEARCH_MAX_RETRIES=1
FITCHECK_SEARCH_EXPANSION_LIMIT=3

# Optional search domain policy. Allowed domains is an allowlist when non-empty.
# FITCHECK_SEARCH_ALLOWED_DOMAINS=musinsa.com,29cm.co.kr,wconcept.co.kr,smartstore.naver.com
# FITCHECK_SEARCH_PREFERRED_DOMAINS=musinsa.com,29cm.co.kr,wconcept.co.kr,smartstore.naver.com,naver.com
# FITCHECK_SEARCH_BLOCKED_DOMAINS=instagram.com,facebook.com,youtube.com,pinterest.com,reddit.com,tistory.com,brunch.co.kr,medium.com

# Other supported search providers.
# FITCHECK_SEARCH_PROVIDER=tavily_search
# TAVILY_API_KEY=
# FITCHECK_TAVILY_SEARCH_DEPTH=basic
# FITCHECK_TAVILY_TOPIC=general
# FITCHECK_TAVILY_COUNTRY=south korea
# Google CSE is legacy/transition-only for accounts that still have access.
# FITCHECK_SEARCH_PROVIDER=google_cse
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# FITCHECK_SEARCH_PROVIDER=jina_search
# JINA_API_KEY=
# FITCHECK_SEARCH_PROVIDER=searxng
# FITCHECK_SEARXNG_URL=http://127.0.0.1:8080
# FITCHECK_SEARCH_PROVIDER=duckduckgo_html

# OCR boundary. The fixture boundary is not live OCR.
FITCHECK_OCR_PROVIDER=fixture_boundary
# FITCHECK_OCR_PROVIDER=tesseract_cli
# FITCHECK_OCR_LANGS=kor+eng
# FITCHECK_OCR_TIMEOUT=12
# Windows direct execution:
# FITCHECK_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# WSL execution against Windows Tesseract:
# FITCHECK_TESSERACT_CMD=/mnt/c/com2us/tools/tesseract-wsl-wrapper
# TESSDATA_PREFIX=C:\com2us\tools\tessdata
